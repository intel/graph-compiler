@PACKAGE_INIT@

set(GraphCompiler_ENABLE_IGC @GC_ENABLE_IGC@)
set(GraphCompiler_ENABLE_OCL @GC_ENABLE_OCL@)

include(CMakeFindDependencyMacro)

find_dependency(MLIR REQUIRED CONFIG)
if(NOT TARGET LLVM)
  find_dependency(LLVM REQUIRED CONFIG)
endif()

if(GraphCompiler_ENABLE_OCL)
  find_dependency(OpenCL REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/GraphCompilerTargets.cmake")

if(TARGET GcInterface)
  set_property(TARGET GcInterface APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES "${LLVM_INCLUDE_DIRS};${MLIR_INCLUDE_DIRS}")
endif()
